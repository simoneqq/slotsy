<Window x:Class="KasynoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slot Machine 5×5 | RTP ≈ 98%"
        Height="840" Width="640"
        Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Panel statystyk -->
            <RowDefinition Height="Auto"/>
            <!-- Bębny         -->
            <RowDefinition Height="Auto"/>
            <!-- Przyciski     -->
            <RowDefinition Height="Auto"/>
            <!-- Tabela wypłat -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             ROW 0 – PANEL STATYSTYK
        ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1E1E1E" Padding="14,10"
                CornerRadius="12" BorderBrush="#FFD700" BorderThickness="2"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="MoneyLabel"
                               Text="💰  1000 monet"
                               Foreground="#FFD700" FontSize="19" FontWeight="Bold"
                               FontFamily="Arial Black"/>
                    <TextBlock x:Name="BetLabel"
                               Text="🎲  Stawka: 21 (1/linię × 21)"
                               Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock x:Name="StatusLabel"
                           Grid.Column="1"
                           Text="Naciśnij SPIN aby zagrać!"
                           Foreground="White" FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextWrapping="Wrap" MaxWidth="210"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 – BĘBNY
        ══════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#222222" Padding="15"
                CornerRadius="15" BorderBrush="#FFD700" BorderThickness="4">
            <StackPanel Orientation="Horizontal" Background="#0A0A0A">

                <Border Width="95" Height="375" Margin="3" CornerRadius="8"
                        ClipToBounds="True" Background="#1A1A1A">
                    <Canvas Width="95" Height="375">
                        <StackPanel x:Name="Drum1" Orientation="Vertical" Width="95" Height="3000">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Border>

                <Border Width="95" Height="375" Margin="3" CornerRadius="8"
                        ClipToBounds="True" Background="#1A1A1A">
                    <Canvas Width="95" Height="375">
                        <StackPanel x:Name="Drum2" Orientation="Vertical" Width="95" Height="3000">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Border>

                <Border Width="95" Height="375" Margin="3" CornerRadius="8"
                        ClipToBounds="True" Background="#1A1A1A">
                    <Canvas Width="95" Height="375">
                        <StackPanel x:Name="Drum3" Orientation="Vertical" Width="95" Height="3000">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Border>

                <Border Width="95" Height="375" Margin="3" CornerRadius="8"
                        ClipToBounds="True" Background="#1A1A1A">
                    <Canvas Width="95" Height="375">
                        <StackPanel x:Name="Drum4" Orientation="Vertical" Width="95" Height="3000">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Border>

                <Border Width="95" Height="375" Margin="3" CornerRadius="8"
                        ClipToBounds="True" Background="#1A1A1A">
                    <Canvas Width="95" Height="375">
                        <StackPanel x:Name="Drum5" Orientation="Vertical" Width="95" Height="3000">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Border>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 2 – PRZYCISKI STEROWANIA
        ══════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,18,0,0">

            <!-- BET – -->
            <Button x:Name="BetDownButton" Content="BET −"
                    Width="105" Height="55" Margin="0,0,12,0"
                    Foreground="White" FontSize="17" FontWeight="Bold" Cursor="Hand"
                    Click="BetDownButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2E2E2E"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10" BorderBrush="#666" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#484848"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#444"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- SPIN / RESET -->
            <Button x:Name="SpinButton" Content="SPIN!"
                    Width="170" Height="55" Margin="0,0,12,0"
                    Foreground="Black" FontSize="24" FontWeight="Bold" Cursor="Hand"
                    Click="SpinButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFD700"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12" BorderBrush="#FFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- BET + -->
            <Button x:Name="BetUpButton" Content="BET +"
                    Width="105" Height="55"
                    Foreground="White" FontSize="17" FontWeight="Bold" Cursor="Hand"
                    Click="BetUpButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2E2E2E"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10" BorderBrush="#666" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#484848"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#444"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ══════════════════════════════════════
             ROW 3 – TABELA WYPŁAT
        ══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#161616" Padding="14,10"
                CornerRadius="10" BorderBrush="#383838" BorderThickness="1"
                Margin="0,15,0,0">
            <StackPanel>

                <TextBlock Text="TABELA WYPŁAT  (mnożnik × stawka/linię)"
                           Foreground="#777" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Nagłówek -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol"    Foreground="#666" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="3 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="4 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="5 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- 777 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="777"    Foreground="#FFD700" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="×20"    Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="×100"   Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="×800 🏆" Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- BAR -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="BAR"    Foreground="#00FFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="×10"    Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="×50"    Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="×350"   Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- CHERRY -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CHERRY" Foreground="#FF4646" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="×6"     Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="×30"    Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="×200"   Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- LEMON -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="LEMON"  Foreground="#FFFF00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="×3"     Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="×15"    Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="×100"   Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- GRAPE -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="GRAPE"  Foreground="#BE50FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="×1"     Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="×5"     Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="×30"    Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Text="RTP ≈ 98%  ·  21 linii wypłatnych  ·  Tylko do celów edukacyjnych i naukowych"
                           Foreground="#444" FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>