<Window x:Class="KasynoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduKasyno | Gry Edukacyjne"
        Height="870" Width="650"
        Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Styl przycisków zakładów ruletki -->
        <Style x:Key="BetBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="#444" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku WSTECZ -->
        <Style x:Key="BackBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderBrush="#555" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ══════════════════════════════════════════
             SLOTY
        ══════════════════════════════════════════ -->
        <Grid x:Name="GameGrid"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Margin="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0 – przycisk Wstecz + panel statystyk -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SlotBackButton" Grid.Column="0"
                        Content="← MENU" Width="90" Height="45" Margin="0,0,8,0"
                        Background="#2A2A2A"
                        Style="{StaticResource BackBtnStyle}"
                        Click="SlotBackButton_Click"/>

                <Border Grid.Column="1"
                        Background="#1E1E1E" Padding="14,10"
                        CornerRadius="12" BorderBrush="#FFD700" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="MoneyLabel"
                                       Text="💰  1000 monet"
                                       Foreground="#FFD700" FontSize="19" FontWeight="Bold"
                                       FontFamily="Arial Black"/>
                            <TextBlock x:Name="BetLabel"
                                       Text="🎲  Stawka: 21 (1/linię × 21)"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusLabel" Grid.Column="1"
                                   Text="Naciśnij SPIN aby zagrać!"
                                   Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   TextWrapping="Wrap" MaxWidth="200"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 1 – bębny (bez zmian) -->
            <Border Grid.Row="1"
                    Background="#222222" Padding="15"
                    CornerRadius="15" BorderBrush="#FFD700" BorderThickness="4">
                <StackPanel Orientation="Horizontal" Background="#0A0A0A">
                    <Border Width="95" Height="375" Margin="3" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                        <Canvas Width="95" Height="375">
                            <StackPanel x:Name="Drum1" Orientation="Vertical" Width="95" Height="3000">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <Border Width="95" Height="375" Margin="3" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                        <Canvas Width="95" Height="375">
                            <StackPanel x:Name="Drum2" Orientation="Vertical" Width="95" Height="3000">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <Border Width="95" Height="375" Margin="3" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                        <Canvas Width="95" Height="375">
                            <StackPanel x:Name="Drum3" Orientation="Vertical" Width="95" Height="3000">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <Border Width="95" Height="375" Margin="3" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                        <Canvas Width="95" Height="375">
                            <StackPanel x:Name="Drum4" Orientation="Vertical" Width="95" Height="3000">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <Border Width="95" Height="375" Margin="3" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                        <Canvas Width="95" Height="375">
                            <StackPanel x:Name="Drum5" Orientation="Vertical" Width="95" Height="3000">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ROW 2 – przyciski (bez zmian) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="BetDownButton" Content="BET −"
                        Width="105" Height="55" Margin="0,0,12,0"
                        Foreground="White" FontSize="17" FontWeight="Bold" Cursor="Hand"
                        Click="BetDownButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2E2E2E"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#666" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#484848"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="SpinButton" Content="SPIN!"
                        Width="170" Height="55" Margin="0,0,12,0"
                        Foreground="Black" FontSize="24" FontWeight="Bold" Cursor="Hand"
                        Click="SpinButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFD700"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#444"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BetUpButton" Content="BET +"
                        Width="105" Height="55"
                        Foreground="White" FontSize="17" FontWeight="Bold" Cursor="Hand"
                        Click="BetUpButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2E2E2E"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#666" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#484848"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- ROW 3 – tabela wypłat (bez zmian) -->
            <Border Grid.Row="3" Background="#161616" Padding="14,10"
                    CornerRadius="10" BorderBrush="#383838" BorderThickness="1" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="TABELA WYPŁAT  (mnożnik × stawka/linię)"
                               Foreground="#777" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol"    Foreground="#666" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="3 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="4 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="5 z rzędu" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="777"    Foreground="#FFD700" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="×20"    Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="×100"   Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="×800 🏆" Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="BAR"    Foreground="#00FFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="×10"    Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="×50"    Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="×350"   Foreground="#00FFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CHERRY" Foreground="#FF4646" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="×6"     Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="×30"    Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="×200"   Foreground="#FF4646" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="LEMON"  Foreground="#FFFF00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="×3"     Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="×15"    Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="×100"   Foreground="#FFFF00" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="GRAPE"  Foreground="#BE50FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="×1"     Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="×5"     Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="×30"    Foreground="#BE50FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Text="RTP ≈ 98%  ·  21 linii wypłatnych  ·  Tylko do celów edukacyjnych i naukowych"
                               Foreground="#444" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- koniec GameGrid -->


        <!-- ══════════════════════════════════════════
             RULETKA
        ══════════════════════════════════════════ -->
        <Grid x:Name="RouletteGrid"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="628" Visibility="Collapsed" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: wstecz + saldo -->
                <RowDefinition Height="Auto"/>
                <!-- 1: wyświetlacz koła -->
                <RowDefinition Height="Auto"/>
                <!-- 2: stół zakładów (kod C#) -->
                <RowDefinition Height="Auto"/>
                <!-- 3: wybór żetonu -->
                <RowDefinition Height="Auto"/>
                <!-- 4: przyciski akcji -->
            </Grid.RowDefinitions>

            <!-- ROW 0 – Wstecz + saldo -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RouletteBackButton" Grid.Column="0"
                        Content="← MENU" Width="90" Height="45" Margin="0,0,8,0"
                        Background="#2A2A2A"
                        Style="{StaticResource BackBtnStyle}"
                        Click="RouletteBackButton_Click"/>
                <Border Grid.Column="1" Background="#1E1E1E" Padding="12,8"
                        CornerRadius="12" BorderBrush="#BE50FF" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="RouletteMoneyLabel"
                                       Text="💰  1000 monet"
                                       Foreground="#BE50FF" FontSize="17" FontWeight="Bold"
                                       FontFamily="Arial Black"/>
                            <TextBlock x:Name="RouletteTotalBetLabel"
                                       Text="🎲  Stawka: 0 monet"
                                       Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="RouletteStatusLabel" Grid.Column="1"
                                   Text="Postaw zakłady i kręć kołem!"
                                   Foreground="White" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   TextWrapping="Wrap" MaxWidth="200"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 1 – Wyświetlacz koła -->
            <Border Grid.Row="1" Background="#1A1A1A" Padding="12,10"
                    CornerRadius="12" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Koło z numerem -->
                    <Border x:Name="RouletteResultCircle" Grid.Column="0"
                            Width="66" Height="66" CornerRadius="33"
                            Background="#2A2A2A" Margin="0,0,14,0">
                        <TextBlock x:Name="RouletteResultNumber" Text="?"
                                   FontSize="26" FontFamily="Arial Black" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Status + kolor -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RouletteWheelStatus"
                                   Text="Wybierz żeton, postaw zakład, kliknij KRĘĆ!"
                                   Foreground="#DDD" FontSize="12" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="RouletteColorName" Text=""
                                   Foreground="#888" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Historia 5 ostatnich wyników -->
                    <StackPanel Grid.Column="2" Orientation="Vertical"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Ostatnie:" Foreground="#555" FontSize="9"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <ItemsControl x:Name="LastResults">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Color}"
                                            CornerRadius="11" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="{Binding Number}"
                                                   FontSize="8" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2 – Stół zakładów (wypełniany przez C#) -->
            <Border Grid.Row="2" Background="#161616" Padding="5"
                    CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1"
                    Margin="0,0,0,6">
                <Grid x:Name="RouletteTableGrid"/>
            </Border>

            <!-- ROW 3 – Wybór żetonu -->
            <Border Grid.Row="3" Background="#1A1A1A" Padding="10,8"
                    CornerRadius="10" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ŻETON:" Foreground="#666" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ChipBtn1"   Content="1"   Tag="1"   Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#7A0000" Style="{StaticResource BetBtnStyle}"/>
                    <Button x:Name="ChipBtn5"   Content="5"   Tag="5"   Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#1A541A" Style="{StaticResource BetBtnStyle}"/>
                    <Button x:Name="ChipBtn10"  Content="10"  Tag="10"  Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#1A1A7A" Style="{StaticResource BetBtnStyle}"/>
                    <Button x:Name="ChipBtn25"  Content="25"  Tag="25"  Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#5A3800" Style="{StaticResource BetBtnStyle}"/>
                    <Button x:Name="ChipBtn100" Content="100" Tag="100" Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#3A0050" Style="{StaticResource BetBtnStyle}"/>
                    <Button x:Name="ChipBtn500" Content="500" Tag="500" Width="50" Height="36" Margin="3,0" Click="ChipButton_Click" Background="#003A3A" Style="{StaticResource BetBtnStyle}"/>
                </StackPanel>
            </Border>

            <!-- ROW 4 – Wyczyść + Kręć -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RouletteClearButton" Content="WYCZYŚĆ"
                        Width="130" Height="52" Margin="0,0,14,0"
                        Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Click="RouletteClearButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A1515"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#666" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A2020"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="RouletteSpinButton" Content="KRĘĆ! 🎡"
                        Width="210" Height="52"
                        Foreground="Black" FontSize="20" FontWeight="Bold" Cursor="Hand"
                        Click="RouletteSpinButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#BE50FF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D070FF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#444"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <!-- koniec RouletteGrid -->


        <!-- ══════════════════════════════════════════
             EKRAN STARTOWY
        ══════════════════════════════════════════ -->
        <Grid x:Name="StartScreen" Background="#121212">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">

                <!-- Logo -->
                <Border Background="#1A1A1A" CornerRadius="20"
                        BorderBrush="#FFD700" BorderThickness="3"
                        Padding="30,22" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="🎓 EduKasyno"
                                   FontFamily="Arial Black" FontSize="38" FontWeight="Bold"
                                   Foreground="#FFD700" HorizontalAlignment="Center"/>
                        <TextBlock Text="Poznaj matematykę i statystykę przez zabawę"
                                   FontSize="13" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="WYBIERZ GRĘ"
                           FontFamily="Arial Black" FontSize="13" FontWeight="Bold"
                           Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <!-- Kafelek: Sloty -->
                <Border x:Name="SlotCard" Background="#1E1E1E" CornerRadius="14"
                        BorderBrush="#FFD700" BorderThickness="2"
                        Padding="20,16" Margin="0,0,0,12" Cursor="Hand"
                        MouseLeftButtonUp="SlotCard_Click">
                    <Border.Style>
